plugins {
    id 'com.android.application'
    id 'org.jetbrains.kotlin.android'
}

android {
    namespace 'com.abliteration.ai'
    compileSdk 34

    defaultConfig {
        applicationId "com.abliteration.ai"
        minSdk 26
        targetSdk 34
        versionCode 1
        versionName "1.0"
    }

    buildTypes {
        release {
            minifyEnabled false
            proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'proguard-rules.pro'
        }
    }
    compileOptions {
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
    }
    kotlinOptions {
        jvmTarget = '17'
    }
}

dependencies {
    implementation 'androidx.core:core-ktx:1.12.0'
    implementation 'androidx.appcompat:appcompat:1.6.1'
    implementation 'com.google.android.material:material:1.11.0'
    implementation 'androidx.constraintlayout:constraintlayout:2.1.4'
    
    // ONNX Runtime for Image Generation (Stable Diffusion)
    implementation 'com.microsoft.onnxruntime:onnxruntime-android:1.18.0'
    
    // Llama.cpp bindings (Using a common wrapper for Android)
    implementation 'org.llama-cpp:llama-android:0.2.0' 

    // For file handling (Loading LoRAs/Models)
    implementation 'androidx.documentfile:documentfile:1.0.1'
}
